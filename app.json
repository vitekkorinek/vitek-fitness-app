{
  "expo": {
    "name": "vitek-fitness-app",
    "slug": "vitek-fitness-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitekfitnessapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitekfitness.trainer",
      "appleTeamId": "SGZ83SR8YV",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSMotionUsageDescription": "Vitek Fitness uses the phone's motion sensors to tell you when you're holding the camera at the same angle as your last progress photo, so the two are comparable."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@bacons/apple-targets",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Manrope_400Regular.ttf",
            "./assets/fonts/Manrope_500Medium.ttf",
            "./assets/fonts/Manrope_600SemiBold.ttf",
            "./assets/fonts/Manrope_700Bold.ttf",
            "./assets/fonts/Manrope_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vitek Fitness to access your photos to set a workout cover image."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vitek Fitness to use the camera to scan food barcodes."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Dark",
            "ios": "./assets/app-icons/icon-dark.png"
          },
          {
            "name": "Bright",
            "ios": "./assets/app-icons/icon-bright.png"
          },
          {
            "name": "Shadow",
            "ios": "./assets/app-icons/icon-shadow.png"
          },
          {
            "name": "Mint",
            "ios": "./assets/app-icons/icon-mint.png"
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85dfc4d7-bccb-4073-8d15-3d593d11db5a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/85dfc4d7-bccb-4073-8d15-3d593d11db5a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    }
  }
}
